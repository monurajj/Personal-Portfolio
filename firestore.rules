rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact-form inbox: anyone may leave a well-formed message, nobody can
    // read, edit or delete them from the client. Read them in the Firebase
    // console or with the Admin SDK.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'email', 'message', 'ip', 'userAgent', 'referer',
            'source', 'status', 'createdAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000
        && request.resource.data.source == 'portfolio-contact-form'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Drone-game leaderboard: public read, append-only well-formed rows.
    // Admin allow-list: only the server (Admin SDK) touches this.
    match /admins/{email} {
      allow read, write: if false;
    }

    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pilot', 'time', 'hits', 'gates', 'score', 'level', 'source', 'createdAt'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000
        && request.resource.data.pilot is string
        && request.resource.data.pilot.size() >= 1
        && request.resource.data.pilot.size() <= 64
        // Last line of defence for writes that skip the site. The full filter (leetspeak,
        // spacing, allowlisted names) lives in src/lib/profanity.ts; this blocks the plain
        // forms only, and never a name the site itself would accept.
        && !request.resource.data.pilot.lower().matches('.*(fuck|bitch|pussy|porn|whore|slut|nigg|dildo|sexy|lauda|lavda|chutiy|chutia|bhosd|bhench|behench|madarch|betich|chudai|gaandu).*')
        && !request.resource.data.pilot.lower().matches('(.*[^a-z])?(sex|ass|dick|cock|cunt|shit|lund|chut|gand|gandu|randi|bsdk)([^a-z].*)?')
        && request.resource.data.time is number
        && request.resource.data.time > 0
        && request.resource.data.time < 3600
        && request.resource.data.hits is int
        && request.resource.data.hits >= 0
        && request.resource.data.gates is int
        && request.resource.data.source == 'fly'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
